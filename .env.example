# Copy to .env  (or paste the key in the app's Settings screen instead)
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when the key is org-level (not scoped to a workspace): Console → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=wrkspc_...
CLAUDE_MODEL=claude-opus-5
PORT=3000
# Public base URL used in owner intake links (e.g. an ngrok URL for a live demo on a phone)
BASE_URL=http://localhost:3000

# --- Web research (all optional) ---
# Reuse a company's research for this many days before "Run full pipeline" refreshes it
RESEARCH_MAX_AGE_DAYS=7
# Re-crawl researched companies every N hours and raise watch alerts (0 = only on demand)
WATCH_INTERVAL_HOURS=0
# Chrome/Edge used to render JavaScript-only websites (auto-detected when unset)
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Store state in Postgres instead of data/db.json (first start migrates the JSON file in)
# DATABASE_URL=postgres://user:pass@localhost:5432/mergero
# Alternative folder for db.json (e.g. to run a second instance)
# DATA_DIR=./data
