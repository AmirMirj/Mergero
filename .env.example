# Copy to .env  (or paste the key in the app's Settings screen instead)
ANTHROPIC_API_KEY=sk-ant-...
# Only needed when the key is org-level (not scoped to a workspace): Console → Settings → Workspaces
ANTHROPIC_WORKSPACE_ID=wrkspc_...
CLAUDE_MODEL=claude-opus-5
PORT=3000
# Public base URL used in owner intake links (e.g. an ngrok URL for a live demo on a phone)
BASE_URL=http://localhost:3000

# --- Web research (all optional) ---
# Reuse a company's research for this many days before "Run full pipeline" refreshes it
RESEARCH_MAX_AGE_DAYS=7
# Re-crawl researched companies every N hours and raise watch alerts (0 = only on demand)
WATCH_INTERVAL_HOURS=0
# Chrome/Edge used to render JavaScript-only websites (auto-detected when unset)
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Store state in Postgres instead of data/db.json (first start migrates the JSON file in)
# DATABASE_URL=postgres://user:pass@localhost:5432/mergero
# Alternative folder for db.json (e.g. to run a second instance)
# DATA_DIR=./data

# --- Real email (all optional; also under Settings → Email delivery) ---
# Resend API key + a sender on a domain verified in Resend. With both set, Send delivers the email; without, Send opens a mailto: link.
# RESEND_API_KEY=re_...
# RESEND_FROM=Timo Tontti <timo@mail.mergero.com>
# Domain with receiving enabled in Resend: owner replies go to owners+<prospect id>@<domain> and route themselves to the prospect
# MAIL_INBOUND_DOMAIN=inbound.mergero.com
# Signing secret of the Resend webhook pointed at <BASE_URL>/api/mail/inbound/resend (events: email.received, email.delivered, email.bounced, email.complained)
# RESEND_WEBHOOK_SECRET=whsec_...
# How often scheduled follow-ups are sent, in minutes (0 = only when POST /api/mail/sweep is called)
# SEND_SWEEP_MINUTES=1

# MGX Deal Engine buyer mandates (optional; without it "Sync from MGX" uses a labelled sample)
MGX_API_URL=
MGX_API_KEY=
# MGX_BUYERS_PATH=/buyers

# Model provider: anthropic (default) or verda = Mistral Large 3 on Verda/DataCrunch (EU-hosted, OpenAI-compatible)
LLM_PROVIDER=verda
VERDA_BASE_URL=https://containers.datacrunch.io/<deployment-name>/v1
VERDA_API_KEY=dc_...
VERDA_MODEL=mistral-large-3
# none = strict EU-only (no fallback to Claude when Verda fails); anthropic = fall back
LLM_FALLBACK=anthropic
